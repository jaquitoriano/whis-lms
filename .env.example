SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=School name <no-reply@your-domain>
# Long random string. The scheduler calls /api/cron/notifications with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
